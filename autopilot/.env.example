PORT=4317

GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4317/auth/google/callback

YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly

# Optional: enables model-based Supervisor review in addition to local guardrails.
# OpenAI API usage is billed separately from ChatGPT subscriptions.
OPENAI_API_KEY=
OPENAI_SUPERVISOR_MODEL=gpt-6-astra
